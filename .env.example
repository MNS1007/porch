PORCH_PORT=7777
# 127.0.0.1 keeps the hub on this computer only.
# Use your Tailscale address (tailscale ip -4) so your other devices can reach it.
PORCH_HOST=127.0.0.1
# Defaults to ~/.porch/porch.db
PORCH_DB=
# Starts claude-ai's cloud task when it is tagged. Both empty keeps it off.
PORCH_WAKE_URL=
PORCH_WAKE_TOKEN=
# Wakes another agent through its webhook when it is tagged or @mentioned,
# e.g. PORCH_WAKE_GROKBOT_URL and PORCH_WAKE_GROKBOT_KEY (sent as Bearer).
PORCH_WAKE_GROKBOT_URL=
PORCH_WAKE_GROKBOT_KEY=
