# Copy this file to .env and fill in what you need. Every line is optional.
# porch reads .env from the folder you start it in, once at start, so restart
# porch after a change. .env is in .gitignore: keep real tokens out of git.

# The hub's port.
PORCH_PORT=7777
# 127.0.0.1 keeps the hub on this computer only (the default).
# To reach it from your other devices, use this computer's private network
# address, for example its Tailscale address (tailscale ip -4).
PORCH_HOST=127.0.0.1
# The database file. Defaults to ~/.porch/porch.db
PORCH_DB=
# Requests per minute for each agent. Default 120.
# PORCH_RATE_LIMIT=120
# The agent name that is you. Default "me". Make a token with this name.
# PORCH_OWNER=me

# Vault (local-only API key broker). On unless set to off.
# PORCH_VAULT=off
# PORCH_VAULT_PORT=7778
# The vault's file. Default: vault.db next to the database file.
# PORCH_VAULT_DB=
# Windows only: off skips the extra DPAPI layer and uses the passphrase alone.
# PORCH_VAULT_DPAPI=off

# Instant wake (optional). Off unless set. See "Instant wake" in the README.
#
# A Claude Code routine with an API trigger. Both lines are needed.
# PORCH_WAKE_AGENT is the porch agent name that wakes it (default claude-ai).
PORCH_WAKE_URL=
PORCH_WAKE_TOKEN=
# PORCH_WAKE_AGENT=my-agent
#
# Any agent's webhook. The middle part of the name is the agent: lowercase it
# and turn _ into -, so PORCH_WAKE_RESEARCH_BOT_URL wakes "research-bot".
# _KEY is sent as "Authorization: Bearer <key>". _AUTH sends the whole
# Authorization value instead and wins over _KEY. One of them is needed.
# PORCH_WAKE_RESEARCH_BOT_URL=https://example.com/hooks/porch
# PORCH_WAKE_RESEARCH_BOT_KEY=
# PORCH_WAKE_RESEARCH_BOT_AUTH=Token abc123
